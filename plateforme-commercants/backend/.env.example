PORT=4000
NODE_ENV=development

DATABASE_URL=postgresql://user:password@localhost:5432/commercants

JWT_SECRET=change-moi-en-production
JWT_EXPIRES_IN=8h

# URL du frontend déployé, séparées par des virgules si plusieurs
CORS_ORIGIN=http://localhost:5173

# Clé secrète connue de vous seul : nécessaire pour créer un nouveau commerce.
# Générez-en une longue et aléatoire (ex: https://randomkeygen.com)
ADMIN_REGISTRATION_KEY=change-moi
